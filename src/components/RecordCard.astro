---
import { formatDate, type MockRecord } from '../data/mock';

interface Props {
  record: MockRecord;
}

const { record } = Astro.props;
---

<article class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-[minmax(0,1fr)_minmax(220px,320px)] sm:p-5">
  <div class="order-2 flex min-w-0 flex-col sm:order-1">
    <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
      发生时间：{formatDate(record.occurredAt)}
    </p>
    <p class="mt-3 leading-7 text-slate-800">{record.content}</p>
    <p class="mt-3 text-xs text-slate-500">提交时间：{formatDate(record.createdAt)}</p>
    <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-5 text-sm font-medium">
      <a
        class="text-cyan-800 underline decoration-cyan-200 underline-offset-4"
        href={`/record/${record.id}`}
      >
        查看记录
      </a>
      <a
        class="text-cyan-800 underline decoration-cyan-200 underline-offset-4"
        href={record.imageUrl}
        rel="noreferrer"
        target="_blank"
      >
        查看原图
      </a>
      {record.sourceUrl ? (
        <a
          class="text-cyan-800 underline decoration-cyan-200 underline-offset-4"
          href={record.sourceUrl}
          rel="noreferrer"
          target="_blank"
        >
          打开原始来源
        </a>
      ) : (
        <span class="text-slate-500">演示记录未附来源链接</span>
      )}
    </div>
  </div>
  <a
    class="order-1 block overflow-hidden rounded-xl bg-slate-100 sm:order-2"
    href={record.imageUrl}
    rel="noreferrer"
    target="_blank"
  >
    <img
      alt="mock 截图占位图，非真实帖子"
      class="h-full max-h-64 min-h-48 w-full object-cover"
      loading="lazy"
      src={record.imageUrl}
    />
  </a>
</article>
