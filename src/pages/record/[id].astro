---
import { demoPerson, demoRecord, formatDate } from '../../data/mock';
import SiteLayout from '../../layouts/SiteLayout.astro';

export function getStaticPaths() {
  return [{ params: { id: demoRecord.id }, props: { record: demoRecord } }];
}

const { record } = Astro.props;
---

<SiteLayout
  title={`公开记录 — ${demoPerson.displayName} (@${demoPerson.handle}) - Internet Memory`}
  description={`@${demoPerson.handle} 相关公开记录的示例详情。`}
  canonicalPath={`/record/${record.id}`}
>
  <main class="mx-auto max-w-4xl px-5 py-10 sm:px-8 sm:py-14">
    <a
      class="text-sm font-semibold text-cyan-800 underline underline-offset-4"
      href={`/@${demoPerson.handle}`}
    >
      ← 返回 @{demoPerson.handle} 档案
    </a>
    <header class="mt-7 border-b border-slate-200 pb-6">
      <p class="text-sm text-slate-500">
        {demoPerson.displayName} · @{demoPerson.handle}
      </p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">公开记录详情</h1>
      <p class="mt-2 text-xs text-slate-500">该页面全部内容仅为 mock 演示，不对应真实事件。</p>
    </header>

    <figure class="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-white">
      <a href={record.imageUrl} rel="noreferrer" target="_blank">
        <img
          alt="mock 截图占位图，非真实 X 帖子"
          class="block h-auto max-h-[75vh] w-full object-contain"
          src={record.imageUrl}
        />
      </a>
      <figcaption class="border-t border-slate-100 px-4 py-3 text-xs text-slate-500">
        演示图片资源；查看原图会打开同一 mock 文件。
      </figcaption>
    </figure>

    <section
      class="mt-7 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7"
      aria-labelledby="description-heading"
    >
      <h2 class="text-sm font-semibold text-slate-500" id="description-heading">
        投稿者说明
      </h2>
      <p class="mt-3 leading-7 text-slate-800">{record.content}</p>
      <dl class="mt-7 grid gap-4 border-t border-slate-100 pt-5 sm:grid-cols-2">
        <div>
          <dt class="text-xs font-semibold text-slate-500">内容发生时间</dt>
          <dd class="mt-1 text-sm">{formatDate(record.occurredAt)}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-slate-500">提交时间</dt>
          <dd class="mt-1 text-sm">{formatDate(record.createdAt)}</dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-xs font-semibold text-slate-500">原始来源</dt>
          <dd class="mt-1 text-sm">
            {record.sourceUrl ? (
              <a
                class="break-all text-cyan-800 underline"
                href={record.sourceUrl}
                rel="noreferrer noopener"
                target="_blank"
              >
                {record.sourceUrl}
              </a>
            ) : (
              <span class="text-slate-600">演示数据未提供来源链接。</span>
            )}
          </dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-xs font-semibold text-slate-500">SHA-256（mock 图片文件）</dt>
          <dd class="mt-1 break-all font-mono text-xs text-slate-700">{record.sha256}</dd>
        </div>
      </dl>
    </section>
  </main>
</SiteLayout>
