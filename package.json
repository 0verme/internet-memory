    "@cloudflare/workers-types": "^5.20260930.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.1.0",
